{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.local/state/omarchy/current/theme/extras/starburst.txt",
    "color": {
      "1": "#b7d6e6",
      "2": "#e8a35a"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#e8a35a",
      "title": "#b7d6e6"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}  ✦ DORADO · LMC" },
    { "type": "custom", "format": "────────────────────────────────────────", "outputColor": "#546c8c" },
    { "type": "os", "key": "✦ os", "format": "{name} {version}" },
    { "type": "kernel", "key": "✦ kernel", "format": "{release}" },
    { "type": "wm", "key": "✦ wm" },
    { "type": "terminal", "key": "✦ term" },
    { "type": "cpu", "key": "✦ cpu", "format": "{name} ({cores-logical}c)" },
    { "type": "gpu", "key": "✦ gpu", "format": "{name}" },
    { "type": "memory", "key": "✦ mem", "format": "{used} / {total} ({percentage})" },
    { "type": "uptime", "key": "✦ up" },
    "break",
    { "type": "colors", "symbol": "circle", "block": { "range": [0, 7] } }
  ]
}
